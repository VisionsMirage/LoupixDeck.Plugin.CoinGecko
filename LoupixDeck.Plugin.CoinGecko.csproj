<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoupixDeck.Plugin.CoinGecko</AssemblyName>
    <RootNamespace>LoupixDeck.Plugin.CoinGecko</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides the SDK assembly; never copy it to the output. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.30.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="icon.png" LogicalName="CoinGecko.icon.png" />
  </ItemGroup>

</Project>
